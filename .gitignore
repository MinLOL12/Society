# gradle
# Anchored to the repo root so they only match Gradle's own output - an
# unanchored "build/" would also swallow src/.../core/build/, which is
# source code, not artefacts.

/.gradle/
/build/
/out/
/classes/

# loom

run/
remappedSrc/

# fabric

.fabric/

# intellij

.idea/
*.iml
*.ipr
*.iws

# eclipse (including vscode)

.classpath
.project
.settings/
/bin/

# macos

.DS_Store
